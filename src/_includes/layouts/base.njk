<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title or 'Permacommons - Minding the Future' }}</title>
    <meta name="description" content="{{ description or 'Building a permanent home for useful shared resources maintained with AI assistance' }}">

    <!-- OpenGraph Meta Tags -->
    <meta property="og:title" content="{{ title or 'Permacommons - Minding the Future' }}">
    <meta property="og:description" content="{{ description or 'Building a permanent home for useful shared resources maintained with AI assistance' }}">
    <meta property="og:type" content="{{ ogType or 'website' }}">
    <meta property="og:url" content="https://permacommons.org{{ page.url or '/' }}">
    <meta property="og:image" content="https://permacommons.org/images/opengraph-banner.jpg">
    <meta property="og:image:alt" content="Permacommons - Minding the Future">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:site_name" content="Permacommons">
    <meta property="og:locale" content="en_US">
    {%- if ogType == 'article' -%}
    <meta property="article:published_time" content="{{ date | dateIso }}">
    {%- if author -%}
    <meta property="article:author" content="{{ author }}">
    {%- endif -%}
    <meta property="article:section" content="Blog">
    {%- if tags -%}
    {%- for tag in tags -%}
    <meta property="article:tag" content="{{ tag }}">
    {%- endfor -%}
    {%- endif -%}
    {%- endif -%}

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ title or 'Permacommons - Minding the Future' }}">
    <meta name="twitter:description" content="{{ description or 'Building a permanent home for useful shared resources maintained with AI assistance' }}">
    <meta name="twitter:image" content="https://permacommons.org/images/opengraph-banner.jpg">
    <meta name="twitter:image:alt" content="Permacommons - Minding the Future">

    <!-- Additional Meta Tags -->
    <meta name="author" content="Permacommons">
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)">
    <meta name="theme-color" content="#161d1b" media="(prefers-color-scheme: dark)">
    <meta name="robots" content="index, follow">
    <link rel="canonical" href="https://permacommons.org{{ page.url or '/' }}">
    <link rel="alternate" type="application/atom+xml" title="Permacommons Blog Feed" href="/feed.xml">

    <link rel="stylesheet" href="/fonts/inter.css">
    <link rel="stylesheet" href="/fonts/source-serif-4.css">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/icons/fontawesome-free-6.7.2-web/css/all.min.css">
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <!-- Navigation -->
    <nav class="nav" aria-label="Main navigation">
      <div class="nav-container">
        <a href="/" class="nav-brand">
          <img src="/images/logo.svg" width="400" height="337" alt="">
          <span>Permacommons</span>
        </a>
        <div class="nav-links">
          <a href="/"{% if page.url == '/' %} aria-current="page"{% endif %}>Home</a>
          <a href="/blog/"{% if page.url == '/blog/' %} aria-current="page"{% elif ogType == 'article' %} aria-current="location"{% endif %}>Blog</a>
          <a href="/faq/"{% if page.url == '/faq/' %} aria-current="page"{% endif %}>FAQ</a>
          <a href="https://github.com/permacommons">GitHub</a>
        </div>
      </div>
    </nav>

    <!-- Main Content -->
    <main id="main">
      {{ content | safe }}
    </main>

    <!-- Footer -->
    <footer class="footer">
      <div class="container">
        <div class="footer-content">
          <div class="footer-section">
            <h2>Permacommons</h2>
            <p>A permanent home for shared resources.</p>
          </div>
          <div class="footer-section">
            <h2>Connect</h2>
            <ul>
              <li><a href="https://github.com/permacommons"><i class="fab fa-github" aria-hidden="true"></i> GitHub</a></li>
              <li><a href="https://bsky.app/profile/permacommons.org"><i class="fab fa-bluesky" aria-hidden="true"></i> Bluesky</a></li>
              <li><a href="mailto:info@permacommons.org"><i class="fas fa-envelope" aria-hidden="true"></i> Email</a></li>
              <li><a href="/feed.xml"><i class="fas fa-rss" aria-hidden="true"></i> Feed</a></li>
              <li><a href="https://chat.halecraft.org/signup_user_complete/?id=pqyayc1khpdpugh9hh9y89nkpr&md=link&sbr=su"><i class="fas fa-comments" aria-hidden="true"></i> Mattermost</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <p>&copy; 2025 Permacommons. Licensed under <a href="https://creativecommons.org/publicdomain/zero/1.0/">CC0</a>.</p>
          <p>Growing a commons, one project at a time.</p>
        </div>
      </div>
    </footer>
  </body>
</html>
