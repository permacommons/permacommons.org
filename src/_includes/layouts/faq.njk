<section class="faq-page">
  <div class="container reading-container">
    <div class="section-header">
      <h1 class="section-title">{{ title or 'Frequently Asked Questions' }}</h1>
      <p class="section-subtitle">{{ description or 'Common questions and answers' }}</p>
    </div>

    <div class="content-card faq-content">
      {{ content | safe }}
    </div>
  </div>
</section>
