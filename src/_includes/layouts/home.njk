---
layout: layouts/base.njk
---

<!-- Hero Section -->
<section class="hero">
  <div class="container">
    <div class="hero-content">
      <h1>Permacommons</h1>
      <p class="hero-tagline">Minding the future.</p>
      <p class="hero-description">A permanent home for useful shared resources, maintained with AI assistance and overseen by people.</p>
      <div class="hero-links">
        <a href="#projects" class="arrow-link">Explore the projects</a>
      </div>
    </div>
  </div>
</section>

<!-- Featured Projects Section -->
<section class="content-section" id="projects">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Shared tools, already taking shape.</h2>
    </div>
    {% from "macros/projects.njk" import project_list %}
    <div class="projects-layout">
      {{ project_list(projects) }}
      <figure class="project-preview">
        <a href="/images/chabeau-code-preview.png" aria-label="View the full-size Chabeau screenshot">
          <img src="/images/chabeau-code-preview.png" width="1200" height="800" alt="Chabeau's terminal interface displaying Python, JavaScript, and SQL code with syntax highlighting." loading="lazy" decoding="async">
        </a>
        <figcaption><span>Chabeau in use</span> A conversation with code, right in the terminal.</figcaption>
      </figure>
    </div>
  </div>
</section>

<!-- Mission Section -->
<section class="content-section mission-section">
  <div class="container mission-layout">
    <div class="section-header">
      <h2 class="section-title">Built to be shared.<br>Maintained to last.</h2>
    </div>
    <div class="prose">
      <p class="mission-lead">Useful software should have a future beyond the time any one person can give it.</p>
      <p>We are growing a community that welcomes responsible AI use in open source development. As the tools improve, we aim to reduce the work of maintenance while people remain responsible for quality, usability, and security.</p>
      <p>Our long-term goal is an endowment that sustains both computing resources and human effort. We are starting with useful software, learning in the open, and building toward a permanent commons.</p>
      <a class="arrow-link" href="/faq/">Our approach and principles</a>
    </div>
  </div>
</section>

<!-- Blog Section -->
<section class="content-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">Notes from the commons</h2>
      <a href="/blog/" class="section-link">All posts <i class="fas fa-arrow-right" aria-hidden="true"></i></a>
    </div>
    <div class="blog-headings">
      {%- for post in collections.posts -%}
        {%- if loop.index <= 3 -%}
      <div class="blog-heading">
        <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
        <p class="blog-post-meta">
          <time datetime="{{ post.date | dateIso }}">{{ post.date | readableDate }}</time>
        </p>
      </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<!-- Call to Action Section -->
<section class="content-section cta-section">
  <div class="container">
    <div class="section-header">
      <h2 class="section-title">There is room for your project.</h2>
    </div>
    <p class="section-subtitle">Bring your tools, ideas, and experience to a community building useful things for everyone.</p>
    <div class="community-links">
      <a href="https://github.com/orgs/permacommons/discussions/categories/show-and-tell" class="arrow-link">Share your project</a>
      <a href="https://github.com/orgs/permacommons/discussions" class="community-secondary">Join the discussion</a>
    </div>
  </div>
</section>
